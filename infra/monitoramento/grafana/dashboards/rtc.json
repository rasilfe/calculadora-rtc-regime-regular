        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Mensagens rejeitadas: JSON inválido, CNPJ divergente ou 5 falhas técnicas seguidas"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Cálculo p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
