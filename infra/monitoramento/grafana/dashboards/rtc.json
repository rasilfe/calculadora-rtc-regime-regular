        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "SUCESSO, PARCIAL (algum item com erro) e ERRO (nota inteira com erro de negócio)"
