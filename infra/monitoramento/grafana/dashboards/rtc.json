      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_detailed_queue_consumers{queue=\"rtc.calculo.entrada\"}",
          "legendFormat": "",
          "refId": "A"
